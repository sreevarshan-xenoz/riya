          },
          "details": {
            "title": "Details",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "notable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notable"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "at",
          "app",
          "title",
          "activity",
          "details",
          "notable"
        ],
        "title": "GlanceInfo",
        "type": "object"
      },
      "Hello": {
        "properties": {
          "expressions": {
            "items": {
              "type": "string"
            },
            "title": "Expressions",
            "type": "array"
          },
          "type": {
            "const": "hello",
            "default": "hello",
