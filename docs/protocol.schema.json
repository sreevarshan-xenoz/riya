            "type": "boolean"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "glances_today": {
            "title": "Glances Today",
            "type": "integer"
          },
          "type": {
            "const": "eyes",
            "default": "eyes",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "dont_look",
          "glances_today",
          "cap"
