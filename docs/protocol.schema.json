  "core_to_body": {
    "$defs": {
      "AgentInfo": {
        "description": "One of the user's agents (a Claude Code session or a Colab run); detail is a sanitized summary, <= 80 chars.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_attention": {
            "title": "Needs Attention",
            "type": "boolean"
          },
          "since": {
            "title": "Since",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "since",
          "detail",
          "needs_attention"
        ],
        "title": "AgentInfo",
        "type": "object"
      },
      "AgentsMsg": {
        "description": "The agents list (attention first, at most 20), sent on change and on hello. hooks_seen_at: when a Claude Code\nhook last reached her (None: never), for the settings page's install status. receiver_ok: the hook receiver is\nserving (False while port 8766 is busy; she retries every 60 s). rejected_recent: hook requests turned away for a\nwrong token in the last 24 h.",
        "properties": {
          "hooks_seen_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hooks Seen At"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/AgentInfo"
            },
            "title": "Items",
            "type": "array"
          },
          "receiver_ok": {
            "default": true,
            "title": "Receiver Ok",
            "type": "boolean"
          },
          "rejected_recent": {
            "default": 0,
            "title": "Rejected Recent",
            "type": "integer"
          },
          "type": {
            "const": "agents",
            "default": "agents",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "AgentsMsg",
        "type": "object"
      },
      "EpisodeInfo": {
        "properties": {
          "ended_at": {
            "title": "Ended At",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "started_at": {
            "title": "Started At",
            "type": "number"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
