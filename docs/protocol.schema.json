        "title": "Hello",
        "type": "object"
      },
      "Look": {
        "description": "The side of her the active window is on (null: none, or her own) and whether she's watching it.",
        "properties": {
          "side": {
            "anyOf": [
              {
                "enum": [
                  "left",
                  "right",
                  "center"
                ],
                "type": "string"
              },
