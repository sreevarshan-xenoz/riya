            "type": "string"
          },
          "spoken": {
            "title": "Spoken",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "say",
            "default": "say",
            "title": "Type",
            "type": "string"
          },
          "utterance_id": {
            "title": "Utterance Id",
            "type": "string"
          }
        },
        "required": [
          "utterance_id",
          "text",
