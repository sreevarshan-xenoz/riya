                "type": "null"
              }
            ],
            "title": "Side"
          },
          "type": {
            "const": "look",
            "default": "look",
            "title": "Type",
            "type": "string"
          },
          "watching": {
            "title": "Watching",
            "type": "boolean"
          }
        },
        "required": [
          "side",
          "watching"
        ],
        "title": "Look",
        "type": "object"
      },
      "MemoriesMsg": {
        "properties": {
