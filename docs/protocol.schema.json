  "core_to_body": {
    "$defs": {
      "ActionInfo": {
        "properties": {
          "at": {
            "title": "At",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "integer"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "id",
          "at",
          "tool",
          "tier",
          "summary",
          "outcome"
        ],
        "title": "ActionInfo",
        "type": "object"
      },
      "ActionsMsg": {
        "description": "Her action log for the settings page, newest first.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/ActionInfo"
            },
            "title": "Items",
            "type": "array"
          },
          "type": {
            "const": "actions",
            "default": "actions",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "ActionsMsg",
        "type": "object"
      },
      "AgentActivity": {
        "description": "What one agent session is doing, for Little Riya's bubble and pose: never spoken. label: a tool name plus a\nredacted file basename or a command's first word, at most 40 chars. at: the core clock when it was made.",
        "properties": {
          "at": {
            "title": "At",
            "type": "number"
          },
          "kind": {
            "enum": [
              "edit",
              "run",
              "read",
              "search",
              "web",
              "delegate",
              "think",
              "wave",
              "done",
              "fail",
              "oops",
              "sparkle"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "maxLength": 40,
            "title": "Label",
            "type": "string"
          },
          "session": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Session",
            "type": "string"
          },
          "type": {
            "const": "agent_activity",
            "default": "agent_activity",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "session",
          "label",
          "kind",
          "at"
        ],
        "title": "AgentActivity",
        "type": "object"
      },
      "AgentInfo": {
        "description": "One of the user's agents (a Claude Code session or a Colab run); detail is a sanitized summary, <= 80 chars.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_attention": {
            "title": "Needs Attention",
            "type": "boolean"
          },
          "since": {
            "title": "Since",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "since",
          "detail",
          "needs_attention"
        ],
        "title": "AgentInfo",
        "type": "object"
      },
      "AgentWindow": {
        "description": "The answer to focus_agent: the agent's window at click time, or null when none was found.",
        "properties": {
          "hwnd": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hwnd"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "type": {
            "const": "agent_window",
            "default": "agent_window",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "AgentWindow",
        "type": "object"
      },
      "AgentsMsg": {
        "description": "The agents list (attention first, at most 20), sent on change and on hello. hooks_seen_at: when a Claude Code\nhook last reached her (None: never), for the settings page's install status. receiver_ok: the hook receiver is\nserving (False while port 8766 is busy; she retries every 60 s). rejected_recent: hook requests turned away for a\nwrong token in the last 24 h.",
        "properties": {
          "hooks_seen_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hooks Seen At"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/AgentInfo"
            },
            "title": "Items",
            "type": "array"
          },
          "receiver_ok": {
            "default": true,
            "title": "Receiver Ok",
            "type": "boolean"
          },
          "rejected_recent": {
            "default": 0,
            "title": "Rejected Recent",
            "type": "integer"
          },
          "type": {
            "const": "agents",
            "default": "agents",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "AgentsMsg",
        "type": "object"
      },
      "ConfirmDone": {
        "description": "A confirmation is over: the body drops its bubble and buttons. outcome is what actually happened: ran (and\nworked), started (a command went to the worker), failed (it ran and failed, or couldn't run: the tool was switched\noff since, or a command is still running), declined, expired, replaced or cancelled.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "ran",
              "started",
              "failed",
              "declined",
              "expired",
              "replaced",
              "cancelled"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "type": {
            "const": "confirm_done",
            "default": "confirm_done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "outcome"
        ],
        "title": "ConfirmDone",
        "type": "object"
      },
      "ConfirmRequest": {
        "description": "A T2 (or raised T1) action waiting for the user's yes: the templated summary, and when it expires (epoch s).",
        "properties": {
          "expires_at": {
            "title": "Expires At",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "type": {
            "const": "confirm_request",
            "default": "confirm_request",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "summary",
          "expires_at"
        ],
        "title": "ConfirmRequest",
        "type": "object"
      },
      "DialInfo": {
        "properties": {
          "hi": {
            "title": "Hi",
            "type": "number"
          },
          "lo": {
            "title": "Lo",
            "type": "number"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "lo",
          "hi"
        ],
        "title": "DialInfo",
        "type": "object"
      },
      "EpisodeInfo": {
        "properties": {
          "ended_at": {
            "title": "Ended At",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "started_at": {
            "title": "Started At",
            "type": "number"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "started_at",
          "ended_at",
          "summary"
        ],
        "title": "EpisodeInfo",
        "type": "object"
      },
      "ErrorMsg": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorMsg",
        "type": "object"
      },
      "ExpressionMsg": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "const": "expression",
            "default": "expression",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ExpressionMsg",
        "type": "object"
      },
      "EyesMsg": {
        "properties": {
          "cap": {
            "title": "Cap",
            "type": "integer"
